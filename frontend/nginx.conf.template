# As variáveis ${...} são substituídas na inicialização do container (envsubst da imagem oficial).
#   BACKEND_SCHEME / BACKEND_HOST / BACKEND_PORT  -> para onde o proxy encaminha
#   NGINX_LOCAL_RESOLVERS                         -> DNS lido do /etc/resolv.conf (ver Dockerfile)

# Se o cliente (Azure) já informou o protocolo, repassa; senão usa o do próprio Nginx.
map $http_x_forwarded_proto $proxy_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 10m;

    # Healthcheck do próprio Nginx (não depende do backend)
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # O Nginx entrega CSS, JavaScript, imagens e vídeo sem passar pelo Django.
    location /static/ {
        alias /usr/share/nginx/html/static/;
        access_log off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # Mantém as páginas Django existentes e encaminha rotas dinâmicas ao backend.
    location / {
        # Resolve o DNS do backend a cada 30s (e não só na inicialização), para não ficar
        # com IP velho se o App Service do backend mudar de endereço.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
        set $backend_upstream ${BACKEND_SCHEME}://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass $backend_upstream;

        proxy_http_version 1.1;
        # O App Service do backend roteia pelo Host: precisa ser o hostname dele.
        proxy_set_header Host ${BACKEND_HOST};
        # $http_host mantém a porta (ex.: localhost:8080); $host a removia e o Django
        # recusava o POST dos formulários com 403 (CSRF) quando a porta não era 80/443.
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_forwarded_proto;
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_HOST};
        proxy_connect_timeout 10s;
        proxy_read_timeout 90s;
    }
}
