# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" (com a senha real) para o GitHub ou qualquer lugar público.
# No Azure, estas mesmas variáveis vão em Configuration > Application settings (backend/frontend).

# =========================== Django ===========================
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-aleatoria
# True só em desenvolvimento. Se a variável não existir, o padrão é False (produção).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LANGUAGE_CODE=pt-br
DJANGO_LOG_LEVEL=INFO
# Cookies "Secure" (só funcionam com HTTPS). Padrão: ligados quando DJANGO_DEBUG=False.
# Para testar o modo produção em http://localhost, use False.
# DJANGO_SECURE_COOKIES=False

# =========================== E-mail ===========================
# Conta de e-mail que vai ENVIAR a notificação (pode ser a mesma que recebe, ou outra)
EMAIL_HOST_USER=seu_email_de_envio@gmail.com
# Senha de APP do Gmail (NÃO é a senha normal da conta).
# Como gerar: Conta Google > Segurança > Verificação em duas etapas (ative) >
# Senhas de app > gere uma senha de 16 dígitos e cole aqui.
EMAIL_HOST_PASSWORD=coloque_aqui_a_senha_de_app_de_16_digitos
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# E-mail que vai RECEBER as confirmações de presença e da lista de presentes
NOTIFICATION_EMAIL=wagfalcon@gmail.com

# =========================== Pix ===========================
# Chave Pix de vocês (CPF, e-mail, telefone ou chave aleatória)
PIX_KEY=coloque_aqui_sua_chave_pix
# Nome do titular da chave, IGUAL aparece no banco. Sem acento, até 25 letras.
PIX_NOME=LARISSA E WAGNER
# Cidade do titular da chave. Sem acento, até 15 letras.
PIX_CIDADE=NATAL

# =========================== Banco de dados ===========================
# sqlite = desenvolvimento sem Docker (python manage.py runserver).
# O docker-compose.yml força postgresql e POSTGRES_HOST=database.
DATABASE_ENGINE=sqlite
POSTGRES_DB=casamento
POSTGRES_USER=casamento
POSTGRES_PASSWORD=troque-por-uma-senha-forte-e-unica
# No Azure: IP privado da VM com o PostgreSQL
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_CONN_MAX_AGE=60
# Segundos que o backend espera o banco ficar disponível ao iniciar
DB_WAIT_TIMEOUT=60

# =========================== Backend (container) ===========================
RUN_MIGRATIONS=true
RUN_COLLECTSTATIC=true
# Cria o superusuário do /admin/ na inicialização (precisa das 3 variáveis DJANGO_SUPERUSER_*)
CREATE_SUPERUSER=false
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=troque-esta-senha
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info
# Host usado pelo HEALTHCHECK do Docker; precisa estar em DJANGO_ALLOWED_HOSTS
HEALTHCHECK_HOST=localhost

# =========================== Imagens Docker / Compose ===========================
DOCKERHUB_USERNAME=wagnernoronha
# Tag semântica (vX.Y.Z). Localmente pode ser "dev"; no Azure nunca use latest.
IMAGE_TAG=v1.0.0
# Porta publicada no seu computador (somente o Nginx fica exposto)
HOST_PORT=8080

# =========================== Frontend (Nginx) ===========================
# Para onde o Nginx encaminha. No compose, o padrão (http / backend / 8000) já funciona.
# No Azure (App Service do frontend), use o hostname do App Service do backend:
#   BACKEND_SCHEME=https
#   BACKEND_HOST=nome-do-app-backend.azurewebsites.net
#   BACKEND_PORT=443
# BACKEND_SCHEME=http
# BACKEND_HOST=backend
# BACKEND_PORT=8000
